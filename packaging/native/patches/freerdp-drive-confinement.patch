+/* Shellune: keep the server inside the mapped folder.
+ *
+ * drive_file_combine_fullpath keeps a path under the base path and refuses "..",
+ * but CreateFileW and FindFirstFileW follow symbolic links, junctions and mount
+ * points, so a link inside the mapped folder would hand the server whatever it
+ * points at. Every open, create, listing, rename target and delete is resolved
+ * first: the deepest part of the path that exists is opened without data access,
+ * and its final path must lie within the final path of the base. A name that does
+ * not exist yet is checked through the directory that would hold it. Anything that
+ * cannot be resolved is refused with ERROR_ACCESS_DENIED. On Windows an opened file
+ * is checked once more through its handle, which also covers a link swapped in
+ * between the check and the open. */
+#if defined(_WIN32)
+WINPR_ATTR_MALLOC(free, 1)
+static WCHAR* drive_file_final_path(HANDLE handle)
+{
+	/* Devices (CON, NUL, COM1, ...) are not files in the folder. */
+	if (GetFileType(handle) != FILE_TYPE_DISK)
+	{
+		SetLastError(ERROR_ACCESS_DENIED);
+		return nullptr;
+	}
+
+	const DWORD flags = FILE_NAME_NORMALIZED | VOLUME_NAME_DOS;
+	const DWORD size = GetFinalPathNameByHandleW(handle, nullptr, 0, flags);
+	if (size == 0)
+		return nullptr;
+
+	WCHAR* buffer = (WCHAR*)calloc((size_t)size + 1, sizeof(WCHAR));
+	if (!buffer)
+	{
+		SetLastError(ERROR_OUTOFMEMORY);
+		return nullptr;
+	}
+
+	const DWORD written = GetFinalPathNameByHandleW(handle, buffer, size + 1, flags);
+	if ((written == 0) || (written > size))
+	{
+		free(buffer);
+		SetLastError(ERROR_ACCESS_DENIED);
+		return nullptr;
+	}
+	return buffer;
+}
+
+WINPR_ATTR_MALLOC(free, 1)
+static WCHAR* drive_file_resolve(const WCHAR* path)
+{
+	HANDLE handle =
+	    CreateFileW(path, 0, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr,
+	                OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, nullptr);
+	if (handle == INVALID_HANDLE_VALUE)
+		return nullptr;
+
+	WCHAR* resolved = drive_file_final_path(handle);
+	const DWORD error = GetLastError();
+	(void)CloseHandle(handle);
+	SetLastError(error);
+	return resolved;
+}
+
+WINPR_ATTR_NODISCARD
+static BOOL drive_file_within(const WCHAR* base, const WCHAR* path)
+{
+	size_t base_length = _wcslen(base);
+	while ((base_length > 0) && (base[base_length - 1] == L'\\'))
+		base_length--;
+
+	const size_t length = _wcslen(path);
+	if ((length < base_length) || (base_length > INT32_MAX))
+		return FALSE;
+	if (CompareStringOrdinal(base, (int)base_length, path, (int)base_length, TRUE) != CSTR_EQUAL)
+		return FALSE;
+	return (length == base_length) || (path[base_length] == L'\\');
+}
+
+WINPR_ATTR_NODISCARD
+static BOOL drive_file_confined(const WCHAR* base_path, const WCHAR* path)
+{
+	BOOL inside = FALSE;
+	WCHAR* base = drive_file_resolve(base_path);
+	WCHAR* probe = _wcsdup(path);
+
+	if (base && probe)
+	{
+		size_t length = _wcslen(probe);
+		for (;;)
+		{
+			WCHAR* resolved = drive_file_resolve(probe);
+			if (resolved)
+			{
+				inside = drive_file_within(base, resolved);
+				free(resolved);
+				break;
+			}
+
+			const DWORD error = GetLastError();
+			if ((error != ERROR_FILE_NOT_FOUND) && (error != ERROR_PATH_NOT_FOUND))
+				break;
+
+			/* Not there yet: check the directory that would hold it. */
+			while ((length > 0) && (probe[length - 1] != L'/') && (probe[length - 1] != L'\\'))
+				length--;
+			while ((length > 0) && ((probe[length - 1] == L'/') || (probe[length - 1] == L'\\')))
+				length--;
+			if (length == 0)
+				break;
+			probe[length] = L'\0';
+		}
+	}
+
+	free(probe);
+	free(base);
+	if (!inside)
+		SetLastError(ERROR_ACCESS_DENIED);
+	return inside;
+}
+
+WINPR_ATTR_NODISCARD
+static BOOL drive_file_handle_confined(const WCHAR* base_path, HANDLE handle)
+{
+	BOOL inside = FALSE;
+	WCHAR* base = drive_file_resolve(base_path);
+	WCHAR* resolved = base ? drive_file_final_path(handle) : nullptr;
+
+	if (base && resolved)
+		inside = drive_file_within(base, resolved);
+
+	free(resolved);
+	free(base);
+	if (!inside)
+		SetLastError(ERROR_ACCESS_DENIED);
+	return inside;
+}
+#else
+WINPR_ATTR_NODISCARD
+static BOOL drive_file_within(const char* base, const char* path)
+{
+	size_t base_length = strlen(base);
+	while ((base_length > 1) && (base[base_length - 1] == '/'))
+		base_length--;
+
+	if (strncmp(base, path, base_length) != 0)
+		return FALSE;
+	if ((base_length == 1) && (base[0] == '/'))
+		return TRUE;
+	return (path[base_length] == '\0') || (path[base_length] == '/');
+}
+
+WINPR_ATTR_NODISCARD
+static BOOL drive_file_confined(const WCHAR* base_path, const WCHAR* path)
+{
+	BOOL inside = FALSE;
+	char* base_utf8 = ConvertWCharToUtf8Alloc(base_path, nullptr);
+	char* base = base_utf8 ? realpath(base_utf8, nullptr) : nullptr;
+	char* probe = ConvertWCharToUtf8Alloc(path, nullptr);
+
+	if (base && probe)
+	{
+		size_t length = strlen(probe);
+		for (;;)
+		{
+			char* resolved = realpath(probe, nullptr);
+			if (resolved)
+			{
+				inside = drive_file_within(base, resolved);
+				free(resolved);
+				break;
+			}
+
+			if (errno != ENOENT)
+				break;
+
+			/* Not there yet: check the directory that would hold it. */
+			while ((length > 0) && (probe[length - 1] != '/'))
+				length--;
+			while ((length > 0) && (probe[length - 1] == '/'))
+				length--;
+			if (length == 0)
+				break;
+			probe[length] = '\0';
+		}
+	}
+
+	free(probe);
+	free(base);
+	free(base_utf8);
+	if (!inside)
+		SetLastError(ERROR_ACCESS_DENIED);
+	return inside;
+}
+#endif
+
+/* Shellune: the directory a listing pattern names must be inside. */
+WINPR_ATTR_NODISCARD
+static BOOL drive_file_parent_confined(const WCHAR* base_path, const WCHAR* path)
+{
+	WCHAR* parent = _wcsdup(path);
+	if (!parent)
+	{
+		SetLastError(ERROR_OUTOFMEMORY);
+		return FALSE;
+	}
+
+	size_t length = _wcslen(parent);
+	while ((length > 0) && (parent[length - 1] != L'/') && (parent[length - 1] != L'\\'))
+		length--;
+	while ((length > 1) && ((parent[length - 1] == L'/') || (parent[length - 1] == L'\\')))
+		length--;
+	if (length > 0)
+		parent[length] = L'\0';
+
+	const BOOL inside = drive_file_confined(base_path, parent);
+	free(parent);
+	return inside;
+}
